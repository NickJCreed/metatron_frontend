# Environment Variables for the Application

# Template Client ID (Replace with your actual client ID)
VITE_TEMPLATE_CLIENT_ID=your_template_client_id_here

# Private Key (Replace with your actual private key)
PRIVATE_KEY=your_private_key_here

# Contract Addresses (Replace with your actual contract addresses)
VITE_STARTUP_CONTRACT_ADDRESS=your_startup_contract_address_here
VITE_INVESTOR_CONTRACT_ADDRESS=your_investor_contract_address_here
VITE_CONNECTOR_CONTRACT_ADDRESS=your_connector_contract_address_here
VITE_ACCESS_CONTRACT_ADDRESS=your_access_contract_address_here

# Firebase (required)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Calendly (optional but recommended for scheduling)
VITE_CALENDLY_URL=https://calendly.com/your-scheduling-link
